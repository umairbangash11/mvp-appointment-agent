# Environment: "development" auto-verifies new doctor signups (skips email
# verification link) for local testing convenience. Leave unset or set to
# "production" everywhere else — a "development" value in a deployed
# environment removes the email-ownership check on signup.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/appointment_db

# JWT Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PHI Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-key-here

# Groq AI — also powers Whisper speech-to-text for WhatsApp voice notes
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# ElevenLabs — text-to-speech for WhatsApp voice-note replies (Arabic + English,
# single multilingual voice via eleven_multilingual_v2)
ELEVENLABS_API_KEY=your_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio WhatsApp (sandbox number shown below is Twilio's free shared sandbox)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Cloud API — active inbound/outbound transport for /whatsapp/webhook.
# WHATSAPP_VERIFY_TOKEN is any string you choose; enter it in the Meta App
# Dashboard's webhook config so the GET /whatsapp/webhook handshake succeeds.
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_TOKEN=your-meta-graph-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourclinic.com
SENDGRID_FROM_NAME=Your Clinic Name

# App URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clinic FAQ config (used by WhatsApp agent)
CLINIC_NAME=Your Medical Clinic
CLINIC_HOURS=Sunday-Thursday 9:00 AM - 6:00 PM (Asia/Dubai)
CLINIC_ADDRESS=Dubai, UAE
CLINIC_PHONE=+9715XXXXXXX
